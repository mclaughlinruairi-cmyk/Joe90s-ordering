# Copy this file to .env for local testing (never commit the real .env).
# In production (Render/Railway/etc.) set these as environment variables
# in the hosting dashboard instead of using a file.

# From https://dashboard.stripe.com/test/apikeys (use test keys until you're ready to go live)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# From the Stripe CLI while testing locally, or from
# https://dashboard.stripe.com/test/webhooks once you add your live webhook endpoint
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# The public URL customers will use once deployed, e.g. https://joe90schipshop.com
# Used to build Stripe's success/cancel redirect links. Leave as-is for local testing.
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
